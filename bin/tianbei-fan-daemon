#!/usr/bin/env python3
"""
Privileged Fan Control Daemon for TianBei MACO (ITE IT8613E).
Manages the it87 hwmon kernel driver, serves a local Unix socket RPC interface,
and executes the hysteresis-smoothed custom fan curve loop safely.
"""

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
from typing import Any, Dict, Optional

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)

from core.config_store import load_config, save_config
from core.hwmon import It8613Controller, find_it8613_hwmon, read_cpu_temp_c, read_telemetry
from core.models import FanConfig, FanMode, interpolate_curve_pct, pct_to_pwm

RUN_DIR = "/run/tianbei-fan"
DEFAULT_SOCKET = os.path.join(RUN_DIR, "control.sock")
PID_FILE = os.path.join(RUN_DIR, "daemon.pid")
PROJECT_KO = os.path.join(BASE_DIR, "driver", "it87", "it87.ko")


def ensure_it8613_driver() -> None:
    """Ensure the IT8613E-capable it87 kernel module is loaded via modprobe or project ko."""
    if find_it8613_hwmon():
        return

    subprocess.run(["modprobe", "it87", "ignore_resource_conflict=1"], capture_output=True, text=True)
    if find_it8613_hwmon():
        return

    # If an older/unmatched it87 somehow loaded without it8613, unload first
    lsmod_out = subprocess.run(["lsmod"], capture_output=True, text=True).stdout
    if any(line.startswith("it87 ") or line.startswith("it87\t") for line in lsmod_out.splitlines()):
        subprocess.run(["rmmod", "it87"], capture_output=True, text=True)

    if not os.path.exists(PROJECT_KO):
        raise RuntimeError(f"找不到内核驱动模块: {PROJECT_KO}")

    res = subprocess.run(
        ["insmod", PROJECT_KO, "ignore_resource_conflict=1"],
        capture_output=True,
        text=True,
    )
    if res.returncode != 0:
        raise RuntimeError(f"insmod it87 失败: {res.stderr.strip() or res.stdout.strip()}")

    for _ in range(10):
        if find_it8613_hwmon():
            return
        time.sleep(0.1)
    raise RuntimeError("加载 it87 后仍未发现 it8613 hwmon 节点")


class FanDaemon:
    """Thread-safe fan mode & curve controller daemon."""

    def __init__(self, config_path: str, uid: int, gid: int, apply_saved: bool = False):
        self.config_path = config_path
        self.uid = uid
        self.gid = gid
        self.ctrl = It8613Controller()
        self.lock = threading.RLock()
        self.stop_event = threading.Event()
        self.wake_event = threading.Event()
        self._shutdown_done = False

        self.config: FanConfig = load_config(self.config_path)
        self.effective_temp_c: Optional[float] = None
        self.raw_temp_c: Optional[float] = None
        self.target_pct: Optional[int] = None
        self.target_pwm: Optional[int] = None
        self.last_written_pwm: Optional[int] = None
        self.last_error: Optional[str] = None
        self.persistent_service = os.path.exists("/etc/systemd/system/tianbei-fan-daemon.service")

        if apply_saved:
            self._apply_current_config_locked()
        else:
            # Sync inferred mode from live hardware unless curve is active
            tel = read_telemetry()
            inferred = tel.get("hw_inferred_mode")
            if inferred in (FanMode.AUTO, FanMode.FULL):
                self.config.mode = inferred

        self.worker = threading.Thread(target=self._control_loop, daemon=True)
        self.worker.start()

    def _step_curve_locked(self) -> None:
        raw_t = read_cpu_temp_c(self.config.sensor_source)
        self.raw_temp_c = round(raw_t, 1) if raw_t is not None else None

        if raw_t is None:
            # Failsafe on sensor failure: 100% fan speed
            self.target_pct = 100
            self.target_pwm = 255
            self.ctrl.apply_manual_pwm(255)
            self.last_written_pwm = 255
            self.last_error = "温度传感器读取失败，已触发 100% 全速安全兜底"
            return

        hyst = float(self.config.hysteresis_c)
        if self.effective_temp_c is None or raw_t >= self.effective_temp_c:
            self.effective_temp_c = raw_t
        elif raw_t <= self.effective_temp_c - hyst:
            # Smoothly track downward without oscillating
            delta = self.effective_temp_c - raw_t
            self.effective_temp_c = max(raw_t, self.effective_temp_c - max(1.0, delta * 0.5))

        eval_temp = max(raw_t, self.effective_temp_c)
        if raw_t >= self.config.critical_temp_c:
            pct = 100.0
        else:
            pct = interpolate_curve_pct(
                self.effective_temp_c,
                self.config.points,
                self.config.critical_temp_c,
            )

        pwm = pct_to_pwm(pct)
        self.target_pct = int(round(pct))
        self.target_pwm = pwm

        tel = read_telemetry()
        if self.last_written_pwm != pwm or tel.get("pwm_enable") != 1:
            self.ctrl.apply_manual_pwm(pwm)
            self.last_written_pwm = pwm
        self.last_error = None

    def _apply_current_config_locked(self) -> None:
        self.last_written_pwm = None
        if self.config.mode == FanMode.AUTO:
            self.effective_temp_c = None
            self.target_pct = None
            self.target_pwm = None
            self.ctrl.apply_factory_auto()
            self.last_error = None
        elif self.config.mode == FanMode.FULL:
            self.effective_temp_c = None
            self.target_pct = 100
            self.target_pwm = 255
            self.ctrl.apply_full_speed()
            self.last_written_pwm = 255
            self.last_error = None
        elif self.config.mode == FanMode.CURVE:
            self.effective_temp_c = None
            self._step_curve_locked()

    def _control_loop(self) -> None:
        while not self.stop_event.is_set():
            poll_s = 1.0
            with self.lock:
                poll_s = self.config.poll_interval_s
                if self.config.mode == FanMode.CURVE:
                    try:
                        self._step_curve_locked()
                    except Exception as exc:
                        self.last_error = str(exc)
            self.wake_event.wait(timeout=poll_s)
            self.wake_event.clear()

    def handle_request(self, req: Dict[str, Any]) -> Dict[str, Any]:
        cmd = req.get("cmd")
        if cmd == "ping":
            return {"ok": True, "pid": os.getpid()}

        if cmd == "status":
            with self.lock:
                tel = read_telemetry()
                return {
                    "ok": True,
                    "daemon_running": True,
                    "daemon_pid": os.getpid(),
                    "persistent_service": os.path.exists("/etc/systemd/system/tianbei-fan-daemon.service"),
                    "config": self.config.to_dict(),
                    "effective_temp_c": round(self.effective_temp_c, 1) if self.effective_temp_c is not None else None,
                    "raw_temp_c": self.raw_temp_c,
                    "target_pct": self.target_pct,
                    "target_pwm": self.target_pwm,
                    "last_error": self.last_error,
                    "telemetry": tel,
                }

        if cmd == "set_config":
            raw_cfg = req.get("config")
            if not isinstance(raw_cfg, dict):
                return {"ok": False, "error": "缺少有效的 config 对象"}
            new_cfg = FanConfig.from_dict(raw_cfg)
            with self.lock:
                self.config = new_cfg
                save_config(self.config, self.config_path, uid=self.uid, gid=self.gid)
                self._apply_current_config_locked()
                self.wake_event.set()
            return self.handle_request({"cmd": "status"})

        if cmd == "shutdown":
            self.shutdown()
            return {"ok": True, "message": "守护进程已退出并恢复原厂自动控速"}

        return {"ok": False, "error": f"不支持的指令: {cmd}"}

    def shutdown(self) -> None:
        if self._shutdown_done:
            return
        self._shutdown_done = True
        self.stop_event.set()
        self.wake_event.set()
        if self.worker.is_alive():
            self.worker.join(timeout=2.0)
        with self.lock:
            if self.config.mode == FanMode.CURVE:
                try:
                    self.ctrl.apply_factory_auto()
                except Exception:
                    pass


def serve(args: argparse.Namespace) -> None:
    os.makedirs(RUN_DIR, mode=0o750, exist_ok=True)
    os.chown(RUN_DIR, 0, args.gid)

    ensure_it8613_driver()

    if os.path.exists(args.socket):
        os.unlink(args.socket)

    daemon = FanDaemon(
        config_path=args.config,
        uid=args.uid,
        gid=args.gid,
        apply_saved=args.apply_saved,
    )

    with open(PID_FILE, "w", encoding="utf-8") as pf:
        pf.write(f"{os.getpid()}\n")

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(args.socket)
    os.chmod(args.socket, 0o660)
    os.chown(args.socket, args.uid, args.gid)
    srv.listen(8)
    srv.settimeout(0.5)

    def _on_signal(_signum, _frame):
        daemon.stop_event.set()
        daemon.wake_event.set()

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)

    try:
        while not daemon.stop_event.is_set():
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            with conn:
                conn.settimeout(2.0)
                chunks = []
                total = 0
                while total < 65536:
                    buf = conn.recv(4096)
                    if not buf:
                        break
                    chunks.append(buf)
                    total += len(buf)
                    if b"\n" in buf:
                        break
                raw = b"".join(chunks).split(b"\n", 1)[0].decode("utf-8", errors="replace").strip()
                if not raw:
                    continue
                try:
                    req = json.loads(raw)
                    resp = daemon.handle_request(req)
                except Exception as exc:
                    resp = {"ok": False, "error": str(exc)}
                conn.sendall((json.dumps(resp, ensure_ascii=False) + "\n").encode("utf-8"))
    finally:
        daemon.shutdown()
        srv.close()
        for p in (args.socket, PID_FILE):
            if os.path.exists(p):
                try:
                    os.unlink(p)
                except OSError:
                    pass


def main() -> None:
    parser = argparse.ArgumentParser(description="TianBei MACO Fan Control Daemon")
    parser.add_argument("--socket", default=DEFAULT_SOCKET)
    parser.add_argument("--config", required=True)
    parser.add_argument("--uid", type=int, required=True)
    parser.add_argument("--gid", type=int, required=True)
    parser.add_argument("--apply-saved", action="store_true")
    args = parser.parse_args()

    if os.geteuid() != 0:
        sys.stderr.write("ERROR: tianbei-fan-daemon must run as root.\n")
        sys.exit(1)

    serve(args)


if __name__ == "__main__":
    main()
